MONGO_URI=mongodb://127.0.0.1:27017/task_management?replicaSet=rs0
JWT_SECRET=replace_with_a_private_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:4200
EXPORT_DIR=./exports
JOB_CAPACITY=10000
JOB_COMPLETED_RETENTION_MS=86400000
JOB_FAILED_RETENTION_MS=604800000
JOB_CLEANUP_INTERVAL_MS=60000
JOB_PROCESSING_LEASE_MS=300000
